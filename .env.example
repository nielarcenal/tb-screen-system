# TB-Screen BHW (mobile) — copy to `.env`, fill in, and NEVER commit the real .env.
#
# Expo only inlines vars prefixed with EXPO_PUBLIC_ into the app bundle.
# The anon key is safe to ship (RLS protects the data). The service_role key
# must NEVER appear in the mobile app — it lives server-side only.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# For the Feature 2 sync-test screen only: the seeded BHW test login so the
# device can authenticate and satisfy RLS while we prove sync. Remove once real
# auth (Feature 3+) lands.
EXPO_PUBLIC_TEST_BHW_EMAIL=bhw@test.local
EXPO_PUBLIC_TEST_BHW_PASSWORD=Test1234!
