# TB-Screen BHW — environment template. Copy to `.env` and fill in.
# NEVER commit the real .env. The service_role key is server-side ONLY.

# --- Supabase project (from: supabase status, or Dashboard → Project Settings → API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Server-side only (Edge Functions / admin scripts). Do NOT ship to the app. ---
SUPABASE_SERVICE_ROLE_KEY=

# --- SMS gateway (Feature 9). Leave SMS_PROVIDER=stub during development so the
#     swappable gateway logs instead of sending. Real Semaphore key added later. ---
SMS_PROVIDER=stub
SEMAPHORE_API_KEY=
