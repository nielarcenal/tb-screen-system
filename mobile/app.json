{
  "expo": {
    "name": "TB-Screen BHW",
    "slug": "tb-screen-bhw",
    "scheme": "tbscreen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tbscreen.bhw",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground-1024.png",
        "backgroundColor": "#0B2E33"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icons/favicon-32.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-1024.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0B2E33"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ecd17ef-64ff-45b9-9d8a-1e86b5a35c2f"
      }
    },
    "owner": "ivanarcenal"
  }
}
