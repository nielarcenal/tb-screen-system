.expo/
.kotlin/
.metro-health-check*
expo-env.d.ts

# Generated Android native project + build artifacts
mobile/android/
.gradle/
.cxx/

# Supabase CLI local state
.branches/
.temp/

# Secrets / key material
*.jks
*.p8
*.p12
*.key
*.pem
